# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/
third-party/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Generated by tool/update_build_info.dart; regenerated before every build
/lib/util/build_info.dart


# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release


# Rust (flutter_rust_bridge) build output
/rust/target/

# Local test / benchmark samples (large files, scratch scripts); not versioned
/big.json
/big.txt
/zbegin.txt
/zend.txt
/test.py

# Local launch shortcuts
*.lnk

# macOS / Linux release artifacts (.zip / .dmg from zmac_build_macos.sh, .tar.gz / .flatpak from zlinux_build.sh)
/dist/

# Linux release artifacts (zlinux_build.sh): flatpak-builder leaves this cache when run from the repo root
/.flatpak-builder/

# Per-developer Apple signing team (see macos/Runner/Configs/DeveloperTeam.xcconfig.example)
/macos/Runner/Configs/DeveloperTeam.xcconfig
