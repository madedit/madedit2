{
  "name": "vim",
  "extends": "default",
  "defaultMode": "normal",
  "bindings": [
    { "mode": "normal", "keys": "h", "command": "caret.left" },
    { "mode": "normal", "keys": "l", "command": "caret.right" },
    { "mode": "normal", "keys": "j", "command": "caret.down" },
    { "mode": "normal", "keys": "k", "command": "caret.up" },
    { "mode": "normal", "keys": "g g", "command": "caret.docStart" },
    { "mode": "normal", "keys": "G", "command": "caret.docEnd" },
    { "mode": "normal", "keys": "control+d", "command": "view.halfPageDown" },
    { "mode": "normal", "keys": "control+u", "command": "view.halfPageUp" },
    { "mode": "normal", "keys": "control+f", "command": "view.pageDown" },
    { "mode": "normal", "keys": "control+b", "command": "view.pageUp" },
    { "mode": "normal", "keys": "i", "command": "vim.enterInsert" },
    { "mode": "normal", "keys": "v", "command": "vim.enterVisual" },
    { "mode": "normal", "keys": "/", "command": "search.find" },
    { "mode": "normal", "keys": "n", "command": "search.findNext" },
    { "mode": "normal", "keys": "N", "command": "search.findPrev" },
    { "mode": "normal", "keys": "p", "command": "edit.paste" },
    { "mode": "normal", "keys": "u", "command": "edit.undo" },
    { "mode": "normal", "keys": "control+r", "command": "edit.redo" },
    { "mode": "normal", "keys": "z c", "command": "fold.fold" },
    { "mode": "normal", "keys": "z o", "command": "fold.unfold" },
    { "mode": "normal", "keys": "z M", "command": "fold.all" },
    { "mode": "normal", "keys": "z R", "command": "fold.unfoldAll" },

    { "mode": "insert", "keys": "escape", "command": "vim.enterNormal" },

    { "mode": "visual", "keys": "escape", "command": "vim.enterNormal" },
    { "mode": "visual", "keys": "h", "command": "caret.leftSelect" },
    { "mode": "visual", "keys": "l", "command": "caret.rightSelect" },
    { "mode": "visual", "keys": "j", "command": "caret.downSelect" },
    { "mode": "visual", "keys": "k", "command": "caret.upSelect" },
    { "mode": "visual", "keys": "left", "command": "caret.leftSelect" },
    { "mode": "visual", "keys": "right", "command": "caret.rightSelect" },
    { "mode": "visual", "keys": "up", "command": "caret.upSelect" },
    { "mode": "visual", "keys": "down", "command": "caret.downSelect" },
    { "mode": "visual", "keys": "home", "command": "caret.lineStartSelect" },
    { "mode": "visual", "keys": "end", "command": "caret.lineEndSelect" },
    { "mode": "visual", "keys": "pageup", "command": "caret.pageUpSelect" },
    { "mode": "visual", "keys": "pagedown", "command": "caret.pageDownSelect" },
    { "mode": "visual", "keys": "g g", "command": "caret.docStartSelect" },
    { "mode": "visual", "keys": "G", "command": "caret.docEndSelect" },
    { "mode": "visual", "keys": "y", "command": "edit.copy" },
    { "mode": "visual", "keys": "x", "command": "edit.cut" },
    { "mode": "visual", "keys": "d", "command": "edit.cut" },

    { "keys": "ctrl+shift+b", "command": "view.explorer" },
    { "keys": "ctrl+alt+d", "command": "cursor.addNextOccurrence" }
  ]
}
