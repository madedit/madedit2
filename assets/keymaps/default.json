{
  "name": "default",
  "defaultMode": null,
  "bindings": [
    { "keys": "left", "command": "caret.left" },
    { "keys": "right", "command": "caret.right" },
    { "keys": "up", "command": "caret.up" },
    { "keys": "down", "command": "caret.down" },
    { "keys": "shift+left", "command": "caret.leftSelect" },
    { "keys": "shift+right", "command": "caret.rightSelect" },
    { "keys": "shift+up", "command": "caret.upSelect" },
    { "keys": "shift+down", "command": "caret.downSelect" },
    { "keys": "alt+left", "command": "caret.wordLeft", "when": "platform == 'macos'" },
    { "keys": "alt+left", "command": "nav.back", "when": "platform != 'macos'" },
    { "keys": "control+-", "command": "nav.back", "when": "platform == 'macos'" },
    { "keys": "alt+right", "command": "caret.wordRight", "when": "platform == 'macos'" },
    { "keys": "alt+right", "command": "nav.forward", "when": "platform != 'macos'" },
    { "keys": "control+shift+-", "command": "nav.forward", "when": "platform == 'macos'" },
    { "keys": "ctrl+k ctrl+q", "command": "nav.lastEdit" },
    { "keys": "shift+alt+left", "command": "caret.wordLeftSelect", "when": "platform == 'macos'" },
    { "keys": "shift+alt+left", "command": "select.shrink", "when": "platform != 'macos'" },
    { "keys": "control+shift+ctrl+left", "command": "select.shrink", "when": "platform == 'macos'" },
    { "keys": "shift+alt+right", "command": "caret.wordRightSelect", "when": "platform == 'macos'" },
    { "keys": "shift+alt+right", "command": "select.expand", "when": "platform != 'macos'" },
    { "keys": "control+shift+ctrl+right", "command": "select.expand", "when": "platform == 'macos'" },
    { "keys": "ctrl+left", "command": "caret.wordLeft", "when": "platform != 'macos'" },
    { "keys": "ctrl+right", "command": "caret.wordRight", "when": "platform != 'macos'" },
    { "keys": "ctrl+shift+left", "command": "caret.wordLeftSelect", "when": "platform != 'macos'" },
    { "keys": "ctrl+shift+right", "command": "caret.wordRightSelect", "when": "platform != 'macos'" },
    { "keys": "ctrl+left", "command": "caret.lineStart", "when": "platform == 'macos'" },
    { "keys": "ctrl+right", "command": "caret.lineEnd", "when": "platform == 'macos'" },
    { "keys": "ctrl+shift+left", "command": "caret.lineStartSelect", "when": "platform == 'macos'" },
    { "keys": "ctrl+shift+right", "command": "caret.lineEndSelect", "when": "platform == 'macos'" },
    { "keys": "home", "command": "caret.lineStart" },
    { "keys": "end", "command": "caret.lineEnd" },
    { "keys": "shift+home", "command": "caret.lineStartSelect" },
    { "keys": "shift+end", "command": "caret.lineEndSelect" },
    { "keys": "ctrl+home", "command": "caret.docStart" },
    { "keys": "ctrl+end", "command": "caret.docEnd" },
    { "keys": "ctrl+shift+home", "command": "caret.docStartSelect" },
    { "keys": "ctrl+shift+end", "command": "caret.docEndSelect" },
    { "keys": "pageup", "command": "caret.pageUp" },
    { "keys": "pagedown", "command": "caret.pageDown" },
    { "keys": "shift+pageup", "command": "caret.pageUpSelect" },
    { "keys": "shift+pagedown", "command": "caret.pageDownSelect" },
    { "keys": "ctrl+x", "command": "edit.cut" },
    { "keys": "ctrl+d", "command": "cursor.addNextOccurrence" },
    { "keys": "ctrl+shift+u", "command": "edit.upper" },
    { "keys": "ctrl+u", "command": "edit.lower" },
    { "keys": "ctrl+j", "command": "edit.joinLines" },
    { "keys": "ctrl+/", "command": "edit.toggleComment" },
    { "keys": "ctrl+shift+/", "command": "edit.toggleBlockComment" },
    { "keys": "ctrl+alt+up", "command": "cursor.addAbove" },
    { "keys": "ctrl+alt+down", "command": "cursor.addBelow" },
    { "keys": "ctrl+shift+l", "command": "cursor.selectAllOccurrences" },
    { "keys": "ctrl+shift+r", "command": "macro.record" },
    { "keys": "ctrl+shift+e", "command": "macro.play" },
    { "keys": "ctrl+b", "command": "view.explorer" },
    { "keys": "ctrl+shift+[", "command": "fold.fold" },
    { "keys": "ctrl+shift+]", "command": "fold.unfold" },
    { "keys": "ctrl+k ctrl+0", "command": "fold.all" },
    { "keys": "ctrl+k ctrl+j", "command": "fold.unfoldAll" },
    { "keys": "ctrl+space", "command": "edit.complete" },
    { "keys": "ctrl+p", "command": "file.quickOpen" },
    { "keys": "ctrl+shift+k", "command": "edit.deleteLine" },
    { "keys": "ctrl+shift+d", "command": "edit.duplicateLine" },
    { "keys": "alt+up", "command": "edit.moveLineUp" },
    { "keys": "alt+down", "command": "edit.moveLineDown" },
    { "keys": "shift+alt+up", "command": "edit.copyLineUp" },
    { "keys": "shift+alt+down", "command": "edit.copyLineDown" },
    { "keys": "ctrl+a", "command": "edit.selectAll" },
    { "keys": "ctrl+n", "command": "file.new" },
    { "keys": "ctrl+shift+n", "command": "file.newWindow" },
    { "keys": "ctrl+shift+w", "command": "file.closeWindow" },
    { "keys": "ctrl+o", "command": "file.open" },
    { "keys": "ctrl+g", "command": "search.gotoLine" },
    { "keys": "ctrl+w", "command": "file.closeTab" },
    { "keys": "ctrl+shift+t", "command": "file.reopenTab" },
    { "keys": "ctrl+shift+p", "command": "view.commandPalette" },
    { "keys": "ctrl+tab", "command": "view.nextTab" },
    { "keys": "ctrl+shift+tab", "command": "view.prevTab" },
    { "keys": "ctrl+pagedown", "command": "view.nextTab" },
    { "keys": "ctrl+pageup", "command": "view.prevTab" },
    { "keys": "alt+1", "command": "view.gotoTab", "args": { "n": 1 } },
    { "keys": "alt+2", "command": "view.gotoTab", "args": { "n": 2 } },
    { "keys": "alt+3", "command": "view.gotoTab", "args": { "n": 3 } },
    { "keys": "alt+4", "command": "view.gotoTab", "args": { "n": 4 } },
    { "keys": "alt+5", "command": "view.gotoTab", "args": { "n": 5 } },
    { "keys": "alt+6", "command": "view.gotoTab", "args": { "n": 6 } },
    { "keys": "alt+7", "command": "view.gotoTab", "args": { "n": 7 } },
    { "keys": "alt+8", "command": "view.gotoTab", "args": { "n": 8 } },
    { "keys": "alt+9", "command": "view.gotoTab", "args": { "n": 9 } },
    { "keys": "ctrl+f", "command": "search.find" },
    { "keys": "ctrl+h", "command": "search.replace" },
    { "keys": "ctrl+shift+f", "command": "search.findInFiles" },
    { "keys": "f3", "command": "search.findNext" },
    { "keys": "shift+f3", "command": "search.findPrev" },
    { "keys": "ctrl+m", "command": "caret.matchBracket" },
    { "keys": "ctrl+f2", "command": "bookmark.toggle" },
    { "keys": "f2", "command": "bookmark.next" },
    { "keys": "shift+f2", "command": "bookmark.prev" },
    { "keys": "ctrl+c", "command": "edit.copy" },
    { "keys": "ctrl+v", "command": "edit.paste" },
    { "keys": "ctrl+z", "command": "edit.undo" },
    { "keys": "ctrl+y", "command": "edit.redo" },
    { "keys": "ctrl+shift+z", "command": "edit.redo" },
    { "keys": "ctrl+s", "command": "edit.save" },
    { "keys": "ctrl+shift+s", "command": "file.saveAs" },
    { "keys": "ctrl+r", "command": "file.openRecent" },
    { "keys": "ctrl+=", "command": "view.zoomIn" },
    { "keys": "ctrl+shift+=", "command": "view.zoomIn" },
    { "keys": "ctrl++", "command": "view.zoomIn" },
    { "keys": "ctrl+-", "command": "view.zoomOut" },
    { "keys": "ctrl+0", "command": "view.zoomReset" },
    { "keys": "ctrl+f5", "command": "run.prompt" },
    { "keys": "ctrl+shift+v", "command": "edit.clipboardHistory" },
    { "keys": "alt+c", "command": "edit.columnEditor" },
    { "keys": "ctrl+backspace", "command": "edit.deleteWordLeft", "when": "platform != 'macos'" },
    { "keys": "ctrl+delete", "command": "edit.deleteWordRight", "when": "platform != 'macos'" },
    { "keys": "alt+backspace", "command": "edit.deleteWordLeft" },
    { "keys": "alt+delete", "command": "edit.deleteWordRight" },
    { "keys": "ctrl+l", "command": "edit.selectLine" },
    { "keys": "ctrl+enter", "command": "edit.insertLineBelow" },
    { "keys": "ctrl+shift+enter", "command": "edit.insertLineAbove" },
    { "keys": "shift+enter", "command": "edit.newlinePlain" },
    { "keys": "alt+z", "command": "wrap.toggle" },
    { "keys": "ctrl+shift+o", "command": "view.outline" },
    { "keys": "ctrl+k ctrl+s", "command": "keymap.editor" },
    { "keys": "ctrl+]", "command": "edit.indent" },
    { "keys": "ctrl+[", "command": "edit.outdent" },
    { "keys": "ctrl+k s", "command": "file.saveAll" },
    { "keys": "ctrl+k ctrl+w", "command": "file.closeAll" },
    { "keys": "ctrl+k ctrl+x", "command": "edit.trimTrailing" },
    { "keys": "ctrl+k ctrl+l", "command": "fold.toggle" },
    { "keys": "ctrl+k m", "command": "syntax.picker" },
    { "keys": "ctrl+shift+h", "command": "search.replaceInFiles" },
    { "keys": "ctrl+up", "command": "view.lineUp", "when": "platform != 'macos'" },
    { "keys": "control+up", "command": "view.lineUp", "when": "platform == 'macos'" },
    { "keys": "control+pageup", "command": "view.lineUp", "when": "platform == 'macos'" },
    { "keys": "ctrl+up", "command": "caret.docStart", "when": "platform == 'macos'" },
    { "keys": "ctrl+shift+up", "command": "caret.docStartSelect", "when": "platform == 'macos'" },
    { "keys": "ctrl+down", "command": "view.lineDown", "when": "platform != 'macos'" },
    { "keys": "control+down", "command": "view.lineDown", "when": "platform == 'macos'" },
    { "keys": "control+pagedown", "command": "view.lineDown", "when": "platform == 'macos'" },
    { "keys": "ctrl+down", "command": "caret.docEnd", "when": "platform == 'macos'" },
    { "keys": "ctrl+shift+down", "command": "caret.docEndSelect", "when": "platform == 'macos'" },
    { "keys": "shift+alt+i", "command": "cursor.lineEnds" },
    { "keys": "ctrl+\\", "command": "view.splitRight" }
  ]
}
